        { "path": "checks[id=anchorage.L].demand", "value": 31.867494254846026, "rtol": 1e-9, "note": "hand: 96000/3012.4740663 * 1.0^1.5 = 31.8674943 in — MATCHES the pre-fix default output because the db^1.5 exponent is invisible at db = 1.0, which is why the exponent bug survived the original #8-only fixtures" }
      ] }
    },
    {
      "name": "no8_confined_spacing",
      "inputs": {
        "geometry": { "L_w_ft": 28.5, "x_L_ft": 1.25, "x_R_ft": 27.25, "lb_L_in": 30, "lb_R_in": 30, "t_w_in": 12, "h_w_ft": 14, "h_gb_in": 24, "b_gb_in": 24 },
        "loads": { "DL_super_plf": 5525, "LL_plf": 5205 },
        "materials": { "fc_psi": 3000, "fy_ksi": 60 },
        "reinf": { "tieBars": { "count": 4, "size": "#8" }, "topBars": { "count": 4, "size": "#8" }, "cover_bot_in": 3, "cover_side_in": 2, "cover_top_in": 2,
          "web": { "size": "#4", "s_in": 12, "layers": 2 },
          "anchorage": { "left": { "type": "hook" }, "right": { "type": "hook" } } }
      },
      "expect": { "status": "ok", "values": [
        { "path": "checks[id=anchorage.L].contributions[0].ldh.psiR", "value": 1, "atol": 0, "note": "disjunct (b): s = 6.33333 >= 6.0" },
        { "path": "checks[id=anchorage.L].demand", "value": 19.917183909278766, "rtol": 1e-9, "note": "hand: 60000/3012.4740663 * 1.0 = 19.9171839 in" }
      ] }
    },
    {
      "name": "no8_confined_ties",
      "inputs": {
        "geometry": { "L_w_ft": 28.5, "x_L_ft": 1.25, "x_R_ft": 27.25, "lb_L_in": 30, "lb_R_in": 30, "t_w_in": 12, "h_w_ft": 14, "h_gb_in": 24, "b_gb_in": 16 },
        "loads": { "DL_super_plf": 5525, "LL_plf": 5205 },
        "materials": { "fc_psi": 3000, "fy_ksi": 60 },
        "reinf": { "tieBars": { "count": 4, "size": "#8" }, "topBars": { "count": 4, "size": "#8" }, "cover_bot_in": 3, "cover_side_in": 2, "cover_top_in": 2,
          "web": { "size": "#4", "s_in": 12, "layers": 2 },
          "anchorage": { "left": { "type": "hook", "ties": { "legs": 2, "size": "#4", "s_in": 3 } }, "right": { "type": "hook", "ties": { "legs": 2, "size": "#4", "s_in": 3 } } } }
      },
      "expect": { "status": "ok", "values": [
        { "path": "checks[id=anchorage.L].contributions[0].ldh.psiR", "value": 1, "atol": 0, "note": "disjunct (a): Ath = 2*0.20*6 = 2.40 >= 0.4*3.16 = 1.264 while s = 3.66667 < 6.0" },
        { "path": "checks[id=anchorage.L].contributions[0].ldh.nTies", "value": 6, "atol": 0, "note": "floor(15*1.0/3)+1 = 6" },
        { "path": "checks[id=anchorage.L].demand", "value": 19.917183909278766, "rtol": 1e-9 }
      ] }
    },
    {
      "name": "no11_unconfined",
      "inputs": {
        "geometry": { "L_w_ft": 28.5, "x_L_ft": 1.25, "x_R_ft": 27.25, "lb_L_in": 30, "lb_R_in": 30, "t_w_in": 12, "h_w_ft": 14, "h_gb_in": 24, "b_gb_in": 24 },
        "loads": { "DL_super_plf": 5525, "LL_plf": 5205 },
        "materials": { "fc_psi": 3000, "fy_ksi": 60 },
