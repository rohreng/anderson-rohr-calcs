        "loads": { "DL_super_plf": 5525, "LL_plf": 5205 },
        "materials": { "fc_psi": 3000, "fy_ksi": 60 },
        "reinf": {
          "tieBars": { "count": 4, "size": "#8" },
          "topBars": { "count": 4, "size": "#8" },
          "cover_bot_in": 3, "cover_side_in": 2, "cover_top_in": 2,
          "web": { "size": "#4", "s_in": 12, "layers": 2 },
          "anchorage": { "left": { "type": "hook" }, "right": { "type": "hook" } }
        },
        "caseD": {
          "nSpans": 2, "L_ft": 26, "lb_in": 30,
          "spanPoint": [{ "D_kip": 0, "L_kip": 0 }, { "D_kip": 0, "L_kip": 0 }],
          "negChord": { "useWallEF": true, "depth_in": 40, "addBars": { "count": 4, "size": "#6", "depth_from_top_in": 3 }, "extension_in": 300 }
        }
      },
      "expect": {
        "status": "ok",
        "values": [
          { "path": "results.model.caseD.spans[0].Mpos_env_kin", "value": 12023.43, "rtol": 0.001, "note": "F2.8(4): pattern value, > 10379.684 all-loaded" },
          { "path": "results.model.caseD.spans[0].Mpos_pattern", "value": "LL[sp1:1,sp2:0]", "note": "span 1 peaks with span 2 bare" },
          { "path": "results.model.caseD.spans[0].Mpos_combo", "value": "1.2D+1.6L" },
          { "path": "results.model.caseD.spans[1].Mpos_env_kin", "value": 12023.43, "rtol": 0.001 },
          { "path": "results.model.caseD.spans[1].Mpos_pattern", "value": "LL[sp1:0,sp2:1]", "note": "mirror image" },
          { "path": "results.model.caseD.spans[0].Tpos_kip", "value": 64.424385, "rtol": 1e-5 },
          { "path": "results.model.caseD.spans[0].zPos_in", "value": 186.628559, "rtol": 1e-6 },
          { "path": "results.model.caseD.spans[0].Tpos_pattern", "value": "LL[sp1:1,sp2:0]" },
          { "path": "checks[id=tie.bottom].demand", "value": 64.424385, "rtol": 1e-5 },
          { "path": "checks[id=tie.bottom].governingCombo", "value": "1.2D+1.6L" },

          { "path": "results.model.caseD.supports[1].Mneg_env_kin", "value": -18452.772, "rtol": 1e-6, "note": "all-loaded governs M-" },
          { "path": "results.model.caseD.supports[1].Mneg_pattern", "value": "LL[sp1:1,sp2:1]" },

          { "path": "results.model.caseD.supports[0].governingPattern", "value": "LL[sp1:1,sp2:0]", "note": "heaviest end-pier bearing demand" },
          { "path": "results.model.caseD.supports[0].R_elastic_kip", "value": 190.96350, "rtol": 1e-6 },
          { "path": "results.model.caseD.supports[0].R_floor_kip", "value": 213.76875, "rtol": 1e-6, "note": "F2.4c" },
          { "path": "results.model.caseD.supports[0].R_used_kip", "value": 213.76875, "rtol": 1e-6, "note": "F2.8(6): the floor governs, 213.769 > 190.964" },
          { "path": "results.model.caseD.supports[0].R_bearing_kip", "value": 236.51625, "rtol": 1e-6, "note": "+ routed 1.5165*15 = 22.7475" },
          { "path": "checks[id=bearing.pier.0].demand", "value": 236.51625, "rtol": 1e-6 },
          { "path": "checks[id=bearing.pier.0].contributions[1].value", "value": 213.76875, "rtol": 1e-6, "note": "R_floor reported alongside R_elastic" },
          { "path": "results.model.caseD.supports[0].sumV_kip", "value": null, "note": "end piers carry no interior-closure residual" },
          { "path": "results.model.caseD.supports[1].sumV_kip", "value": 0, "atol": 1e-9 },
