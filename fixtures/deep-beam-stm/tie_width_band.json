      "inputs": {
        "geometry": { "L_w_ft": 28.5, "x_L_ft": 1.25, "x_R_ft": 27.25, "lb_L_in": 30, "lb_R_in": 30, "t_w_in": 12, "h_w_ft": 14, "h_gb_in": 24, "b_gb_in": 24 },
