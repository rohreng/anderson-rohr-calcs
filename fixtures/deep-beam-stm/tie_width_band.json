          { "path": "results.model.tieBand.wtPhys", "value": 7.0, "rtol": 1e-12, "note": "2*3.500" },
          { "path": "results.model.tieBand.wtMax", "value": 7.745098039215686, "rtol": 1e-12, "note": "189.6/24.48" },
          { "path": "results.model.tieBand.wtGov", "value": 7.0, "rtol": 1e-12, "note": "min -> physical governs" },
          { "path": "results.model.tieBand.capped", "value": false },
          { "path": "results.model.ha_in", "value": 7.0, "rtol": 1e-12, "note": "UNCHANGED node back face" },
          { "path": "checks[id=tie.width].demand", "value": 7.0, "rtol": 1e-12 },
          { "path": "checks[id=tie.width].capacity", "value": 7.745098039215686, "rtol": 1e-12 },
          { "path": "checks[id=tie.width].dcr", "value": 0.9037974683544304, "rtol": 1e-9, "note": "171.36/189.6" },
          { "path": "checks[id=tie.width].pass", "value": true, "note": "single layer — inside band by construction" },
          { "path": "checks[id=tie.width].informational", "value": true, "note": "F1.4: always informational" },
          { "path": "checks[id=tie.width].capped", "value": false },
          { "path": "checks[id=tie.width].nearLimit", "value": false },
          { "path": "checks[id=tie.width].contributions[6].source", "value": "single layer — inside band by construction" },
          { "path": "checks[id=tie.width].contributions[0].value", "value": 7.0, "rtol": 1e-12, "note": "w_t,phys lives in contributions, NOT in demand" },
          { "path": "results.model.T_kip", "value": 99.41577884230226, "rtol": 1e-9, "note": "unchanged (default_case.json)" },
          { "path": "results.model.z_in", "value": 185.61210518976608, "rtol": 1e-9, "note": "unchanged" },
          { "path": "results.model.thetaL_deg", "value": 67.2063341530138, "atol": 1e-9, "note": "unchanged" },
          { "path": "checks[id=anchorage.L].capacity", "value": 29.46032359584895, "rtol": 1e-9, "note": "unchanged available embedment" },
          { "path": "checks[id=anchorage.L].demand", "value": 19.917183909278766, "rtol": 1e-9, "note": "unchanged ldh" },
          { "path": "checks[id=anchorage.L].dcr", "value": 0.6760680630162922, "rtol": 1e-9, "note": "unchanged" },
          { "path": "checks[id=anchorage.L].contributions[0].xCrit_in", "value": 1.46032359584895, "rtol": 1e-7, "note": "29.46032359584895 - (30 + 0 - 2); = 3.5/tan(theta) uncapped, identical" },
          { "path": "checks[id=node.support.L].contributions[2].stress", "value": 1.1835211766940784, "rtol": 1e-9, "note": "back face T/(ha*b_s) = 99.41577884230226/84 — unchanged" },
          { "path": "results.summary.governing.dcr", "value": 1.0, "rtol": 1e-12, "note": "governing = detailing.wallEF (s = 12 in vs min(d/5, 12) = min(37.7, 12) = 12 -> 1.0); tie.width (0.9038) is informational and cannot be selected" }
