          { "path": "results.model.HL_kip", "value": 70, "rtol": 1e-6 },
          { "path": "results.model.HR_kip", "value": 28, "rtol": 1e-6 },
          { "path": "results.model.RtL_kip", "value": 21, "rtol": 1e-6, "note": "mirrored: far support now left" },
