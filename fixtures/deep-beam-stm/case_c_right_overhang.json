          { "x_ft": 32.666666666666664, "width_in": 8, "D_kip": 30, "L_kip": 0 },
          { "x_ft": 17.333333333333332, "width_in": 12, "D_kip": 90, "L_kip": 0 }
        ] },
        "materials": { "fc_psi": 3000, "fy_ksi": 60 },
        "reinf": {
