      "inputs": {
        "geometry": { "L_w_ft": 34, "x_L_ft": 2, "x_R_ft": 25, "lb_L_in": 24, "lb_R_in": 24, "t_w_in": 12, "h_w_ft": 10, "h_gb_in": 24, "b_gb_in": 24, "e_L_in": 12, "e_R_in": 96 },
        "loads": { "DL_super_plf": 0, "LL_plf": 0, "wallSW_plf": 0, "gbSW_plf": 0, "pointLoads": [
