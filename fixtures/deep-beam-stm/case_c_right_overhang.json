          { "path": "results.model.members[id=ttop.ov2-ov1].force_kip", "value": 28, "rtol": 1e-6 },
          { "path": "results.model.members[id=ttop.ov1-Na].force_kip", "value": 42, "rtol": 1e-6 },
          { "path": "results.model.members[id=arch.0].force_kip", "value": -126.19429464124058, "rtol": 1e-6 },
          { "path": "results.model.members[id=arch.1].force_kip", "value": -35, "rtol": 1e-6 },
